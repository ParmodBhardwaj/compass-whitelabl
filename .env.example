# --- Database (legacy MySQL, schema preserved) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=compass
DB_USER=root
DB_PASSWORD=

# --- API ---
API_PORT=4000
API_BASE_URL=http://localhost:4000

# --- Web ---
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Legacy PHP server — used to proxy /files/* (uploaded images, PDFs, etc.)
# In the strangler pattern this is the old Apache/Nginx still running Laminas.
LEGACY_URL=http://localhost:8080

# --- Auth (JWT) ---
JWT_ACCESS_SECRET=change-me-32-bytes
JWT_REFRESH_SECRET=change-me-32-bytes
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- LDAP ---
LDAP_URL=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_SEARCH_BASE=

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# --- SAP (SOAP) ---
SAP_WSDL_URL=
SAP_USERNAME=
SAP_PASSWORD=

# --- Mail ---
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=no-reply@example.com

# --- SMS gateway ---
SMS_API_URL=
SMS_API_KEY=

# --- Redis (BullMQ workers) ---
REDIS_URL=redis://localhost:6379

# --- File storage ---
FILE_STORAGE_ROOT=./storage

# --- Workers / escalation ---
# Fallback email when the target record has no email column (TPM Hazard escalation)
ESCALATION_FALLBACK_EMAIL=

# --- kPoint (video portal) ---
KPOINT_BASE_URL=
KPOINT_API_KEY=

# --- Frontend API URL (used by Next.js browser-side fetch) ---
# Must be accessible from the user's browser, not just the server
NEXT_PUBLIC_API_URL=http://localhost:4000

# ──────────────────────────────────────────────────────────────────────────
# White-label / branding
# ──────────────────────────────────────────────────────────────────────────
# Server-side brand (used in Excel report titles, email subjects/bodies).
BRAND_NAME=Compass
BRAND_LEGAL_NAME=Compass
BRAND_PRODUCT=Compass Portal

# Client-side brand (used in headers, sidebars, login page, gate pass).
# These must be prefixed NEXT_PUBLIC_ so Next.js exposes them to the browser.
NEXT_PUBLIC_BRAND_NAME=Compass
NEXT_PUBLIC_BRAND_LEGAL_NAME=Compass
NEXT_PUBLIC_BRAND_PRODUCT=Compass Portal
NEXT_PUBLIC_BRAND_TAGLINE=Employee portal
NEXT_PUBLIC_BRAND_WELCOME=Welcome
NEXT_PUBLIC_BRAND_LOGO=/img/brand-logo.svg
NEXT_PUBLIC_BRAND_SUPPORT_EMAIL=support@example.com
NEXT_PUBLIC_BRAND_COPYRIGHT_YEAR=2014
